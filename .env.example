NODE_ENV=development
PORT=3000

# Adresse publique du site, sans slash final (sitemap, canonical, liens). Ex. https://sipokteck-portfolio.onrender.com
SITE_URL=http://localhost:3000

# Chaîne de connexion PostgreSQL (Supabase « Session pooler », Neon ou autre). Gardez-la secrète.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Secret de session (32 caractères minimum). Générez-le avec : npm run secrets -- "VotreMotDePasseAdmin"
SESSION_SECRET=
ADMIN_NAME=Jean-Paul AHITE
ADMIN_EMAIL=admin@exemple.com
# Hash bcrypt du mot de passe admin (jamais le mot de passe en clair) : npm run secrets -- "VotreMotDePasseAdmin"
ADMIN_PASSWORD_HASH=

# Coordonnées publiques
CONTACT_EMAIL=jeanpaulahite35@gmail.com
WHATSAPP_PRIMARY=22878003599
WHATSAPP_SECONDARY=22871344338

# Notifications email des devis et messages (optionnel, via Resend — https://resend.com).
# Sans clé, les demandes sont quand même enregistrées et visibles dans l'administration.
RESEND_API_KEY=
# Expéditeur. Avec le compte gratuit Resend, laissez la valeur par défaut tant qu'aucun domaine n'est vérifié.
MAIL_FROM=SIPOKTECH DIGITAL <onboarding@resend.dev>

# Réseaux sociaux (optionnels : seuls les liens renseignés s'affichent). GitHub est affiché par défaut.
SOCIAL_GITHUB=https://github.com/sipok12
SOCIAL_TELEGRAM=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_X=

# --- Supabase (administration : connexion Supabase Auth + images Supabase Storage) ---
# URL du projet (Supabase -> Project Settings -> API). Publique.
SUPABASE_URL=
# Clé PUBLIQUE (« publishable » sb_publishable_... ou « anon »). Sert uniquement à la connexion des administrateurs.
SUPABASE_ANON_KEY=
# Clé SECRÈTE (« secret » sb_secret_... ou « service_role »). Envoi des images. Uniquement dans les variables Render :
# jamais dans le dépôt, jamais dans le navigateur. Sans elle, l'envoi d'images est désactivé (le reste fonctionne).
SUPABASE_SERVICE_ROLE_KEY=
# Nom du bucket d'images (créé automatiquement, public en lecture). Défaut : portfolio
SUPABASE_STORAGE_BUCKET=portfolio
# Autres administrateurs autorisés (emails séparés par des virgules). ADMIN_EMAIL est toujours autorisé.
ADMIN_EMAILS=
# Mettre false une fois votre compte Supabase Auth testé : désactive l'ancien compte (mot de passe haché en base).
ADMIN_LEGACY_LOGIN=true
