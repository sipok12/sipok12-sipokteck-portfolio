NODE_ENV=development
PORT=3000

# Adresse publique du site, sans slash final (sitemap, canonical, liens). Ex. https://sipokteck-portfolio.onrender.com
SITE_URL=http://localhost:3000

# Chaîne de connexion PostgreSQL (Supabase « Session pooler », Neon ou autre). Gardez-la secrète.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Secret de session (32 caractères minimum). Générez-le avec : npm run secrets -- "VotreMotDePasseAdmin"
SESSION_SECRET=
ADMIN_NAME=Jean-Paul AHITE
ADMIN_EMAIL=admin@exemple.com
# Hash bcrypt du mot de passe admin (jamais le mot de passe en clair) : npm run secrets -- "VotreMotDePasseAdmin"
ADMIN_PASSWORD_HASH=

# Coordonnées publiques
CONTACT_EMAIL=jeanpaulahite35@gmail.com
WHATSAPP_PRIMARY=22878003599
WHATSAPP_SECONDARY=22871344338

# Notifications email des devis et messages (optionnel, via Resend — https://resend.com).
# Sans clé, les demandes sont quand même enregistrées et visibles dans l'administration.
RESEND_API_KEY=
# Expéditeur. Avec le compte gratuit Resend, laissez la valeur par défaut tant qu'aucun domaine n'est vérifié.
MAIL_FROM=SIPOKTECH DIGITAL <onboarding@resend.dev>

# Réseaux sociaux (optionnels : seuls les liens renseignés s'affichent). GitHub est affiché par défaut.
SOCIAL_GITHUB=https://github.com/sipok12
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_X=
